# PillSafe systemd service (NFR-12)
# Install on Pi:
#   sudo cp services/pillsafe.service /etc/systemd/system/pillsafe.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable pillsafe
#   sudo systemctl start pillsafe

[Unit]
Description=PillSafe Smart Pill Dispenser Service
After=network.target

[Service]
Type=simple
User=boison08
WorkingDirectory=/home/boison08/Documents/pillSafe_projectupdated/hardware
ExecStart=/usr/bin/python3 /home/boison08/Documents/pillSafe_projectupdated/hardware/main.py
Restart=always
RestartSec=10
StandardOutput=append:/home/boison08/Documents/pillSafe_projectupdated/hardware/data/pillsafe_stdout.log
StandardError=append:/home/boison08/Documents/pillSafe_projectupdated/hardware/data/pillsafe_stderr.log

[Install]
WantedBy=multi-user.target
